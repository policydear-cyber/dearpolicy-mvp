    "eval:claim-quality": "node --import tsx scripts/claim-quality-eval.ts",
    "security:test": "node --import tsx scripts/security-regressions.ts",
    "security:tls-test": "node --import tsx scripts/tls-config-regressions.ts",
    "security:launch-guard-test": "node --import tsx scripts/launch-guard-regressions.ts",
    "security:rls-test": "node --import tsx scripts/rls-regressions.ts",
    "launch:check": "node --import tsx scripts/launch-check.ts",
    "security:authz-client-test": "node --import tsx scripts/authz-client-regressions.ts",
    "security:household-test": "node --import tsx scripts/household-repo-regressions.ts",
    "security:route-inventory-test": "node --import tsx scripts/route-inventory-regressions.ts",
    "security:import-boundary-test": "node --import tsx scripts/import-boundary-regressions.ts",
