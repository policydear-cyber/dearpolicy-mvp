{
  "name": "dearpolicy-mvp",
  "version": "1.0.0-rc.14",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose up -d db",
    "db:status": "docker compose ps",
    "db:setup": "node --import tsx scripts/setup-db.ts",
