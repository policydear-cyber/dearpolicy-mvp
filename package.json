{
  "name": "dearpolicy-mvp",
  "version": "1.0.0-rc.14",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose up -d db",
    "db:status": "docker compose ps",
    "db:setup": "node --import tsx scripts/setup-db.ts",
    "db:check": "node --import tsx scripts/check-database.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "policies:index": "node --import tsx scripts/build-benefit-catalog.ts",
    "policies:report": "node --import tsx scripts/policy-linkage-report.ts",
    "model:benchmark": "node --import tsx scripts/model-benchmark.ts",
    "claims:test": "node --import tsx scripts/claim-smoke.ts",
    "ocr:test": "node --import tsx scripts/ocr-regressions.ts",
    "eval:extraction": "node --import tsx scripts/extraction-eval.ts",
    "system:test": "node --import tsx scripts/system-database-regressions.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
