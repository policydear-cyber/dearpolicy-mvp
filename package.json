    "storage:audit-orphans": "node --import tsx scripts/storage-orphans.ts",
    "security:db-rate-limit-test": "node --import tsx scripts/db-rate-limit-regressions.ts",
    "security:csrf-test": "node --import tsx scripts/csrf-regressions.ts",
    "security:launch-check-test": "node --import tsx scripts/launch-check-regressions.ts",
    "security:policy-quarantine-test": "node --import tsx scripts/policy-quarantine-regressions.ts"
