    "model:benchmark": "node --import tsx scripts/model-benchmark.ts",
    "claims:test": "node --import tsx scripts/claim-smoke.ts",
    "replay": "node --import tsx -e \"import('./scripts/real-household-replay.ts').then(m=>m.runRealHouseholdReplay())\"",
    "ocr:test": "node --import tsx scripts/ocr-regressions.ts",
    "eval:extraction": "node --import tsx scripts/extraction-eval.ts",
    "system:test": "node --import tsx scripts/system-database-regressions.ts",
    "claims:evidence-test": "node --import tsx scripts/claim-evidence-regressions.ts",
    "claims:composition-test": "node --import tsx scripts/claim-composition-regressions.ts",
    "claims:ci-test": "node --import tsx scripts/claim-ci-regressions.ts",
    "claims:medical-test": "node --import tsx scripts/claim-medical-regressions.ts",
    "claims:disability-test": "node --import tsx scripts/claim-disability-regressions.ts",
