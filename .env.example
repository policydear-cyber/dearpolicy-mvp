# Postgres (Supabase in production). Any Postgres 15+ works for local runs.
DATABASE_URL=postgresql://dearpolicy:dearpolicy@127.0.0.1:5432/dearpolicy

# Database TLS. Unset (the default) verifies certificates against Node's
# trust store for any non-localhost DATABASE_URL -- correct for Supabase out
# of the box. DATABASE_SSL=off disables TLS entirely (only for a plain local
# Postgres that speaks no TLS at all; refused at startup in production).
# DATABASE_SSL_INSECURE=true disables certificate verification (only for a
# local TLS-terminating proxy with a self-signed cert; also refused at
# startup in production). If a specific CA bundle is required, set
# DATABASE_SSL_CA (the PEM contents) or DATABASE_SSL_CA_PATH (a file path)
# instead of INSECURE -- both keep verification on.
# DATABASE_SSL=off
# DATABASE_SSL_INSECURE=false
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_PATH=

# Supabase project credentials. Required in production (see
# lib/launch/guards.ts / npm run launch:check) once Supabase Auth replaces
# the shared-password gate below. SUPABASE_URL and SUPABASE_ANON_KEY are also
# needed client-side for the browser to talk to Supabase Auth directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_ -- launch:check fails the
# build if a service-role-looking key is ever exposed under that prefix.
SUPABASE_SERVICE_ROLE_KEY=

# VECTOR DATABASE — Pinecone. Pinecone stores the vectors and does the
# embedding on its own side, for both the passages and the question, so no
# embedding model runs anywhere in this system. The index is created
# automatically the first time a document is uploaded.
# Leave the key unset and DearPolicy falls back to keyword search, which still
# answers, just less well. Get a key at app.pinecone.io.
PINECONE_API_KEY=
# PINECONE_INDEX=dearpolicy
# PINECONE_EMBED_MODEL=llama-text-embed-v2
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Local file store. Replace with S3 provider later.
LOCAL_STORAGE_DIR=./data/storage

# DEVELOPMENT-ONLY identity shortcut. Required (must be exactly "true") for
# the shared-household-password gate (lib/auth/gate.ts) and the fixed
# DEV_ACCOUNT_ID below to do anything at all -- both are hard-disabled
# otherwise, and both are ALWAYS disabled in production regardless of this
# flag (a production boot with DEV_AUTH_ENABLED=true refuses to start; see
# lib/launch/guards.ts). This is the "explicit development-only flag" the
# launch-hardening requirements call for: real production auth is Supabase
# Auth (see the PR description for status), not this.
DEV_AUTH_ENABLED=true
SITE_PASSWORD=
DEV_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# Per-document semantic relevance gate (cosine distance, 0 = closest).
# Lexical matches are always retained. Leave this at the tested default unless tuning with labelled examples.
RAG_MAX_COSINE_DISTANCE=0.72

# Passages read per document per question. Scales with document size between
# these bounds; lower the maximum for faster, shallower answers.
RAG_MIN_PASSAGES_PER_DOCUMENT=6
RAG_MAX_PASSAGES_PER_DOCUMENT=16

# Hard ceilings on the reading work one question can buy. Raise these to read
# more of a long booklet; lower them for faster, cheaper answers. The sections
# of a document are read concurrently, so this bounds spend more than it bounds
# wall-clock time.
RAG_MAX_EVIDENCE_WINDOWS=8
RAG_ANALYSIS_BUDGET_MS=300000
# Characters of evidence handed to the model in one section. Bigger sections
# mean fewer calls and whole clauses rather than halves; smaller ones mean a
# long document needs more sections and is likelier to run out of budget.
RAG_EVIDENCE_WINDOW_CHARACTERS=14000

# Output tokens per evidence section. Time per call is almost exactly output
# tokens divided by the model's tokens/sec.
RAG_READING_OUTPUT_TOKENS=900

# ONE KEY, WHOLE SYSTEM. Every model job is hosted; nothing runs on the machine
# serving the app. These two are all DearPolicy needs to read documents, decide
# what applies and word answers.
MODEL_PRESET=gemini
GEMINI_API_KEY=
# Other presets: anthropic (ANTHROPIC_API_KEY), openai (OPENAI_API_KEY).

# Or route each job yourself: "provider:model". Providers: gemini, anthropic,
# openai, groq — each needs its key below. Unset jobs use the preset, and
# failing that, Google.
#   reading    - a document once, at upload (volume; cheap tier)
#   judgement  - interpreting a message, deciding which benefits respond (mid tier)
#   narration  - two sentences around figures code computed (cheapest)
# READING_MODEL=gemini:flash-lite
# JUDGEMENT_MODEL=gemini:flash
# NARRATION_MODEL=gemini:flash-lite
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Plan allowances shown on the Usage page. The hard stop halts hosted calls
# for the month once a household's model spend passes it.
# PLAN_NAME=Individual
# PLAN_PRICE_USD=4.99
# PLAN_CHAT_TURNS=150
# PLAN_DOCUMENTS=12
# PLAN_HARD_STOP_USD=15
