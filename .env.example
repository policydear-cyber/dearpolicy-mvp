# Postgres (Supabase in production). Any Postgres 15+ works for local runs.
DATABASE_URL=postgresql://dearpolicy:dearpolicy@127.0.0.1:5432/dearpolicy

# Database TLS. Unset (the default) verifies certificates against Node's
# trust store for any non-localhost DATABASE_URL -- correct for Supabase out
# of the box. DATABASE_SSL=off disables TLS entirely (only for a plain local
# Postgres that speaks no TLS at all; refused at startup in production).
# DATABASE_SSL_INSECURE=true disables certificate verification (only for a
# local TLS-terminating proxy with a self-signed cert; also refused at
# startup in production). If a specific CA bundle is required, set
# DATABASE_SSL_CA (the PEM contents) or DATABASE_SSL_CA_PATH (a file path)
# instead of INSECURE -- both keep verification on.
# DATABASE_SSL=off
# DATABASE_SSL_INSECURE=false
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_PATH=

# Supabase project credentials. Required in production (see
# lib/launch/guards.ts / npm run launch:check) once Supabase Auth replaces
# the shared-password gate below. SUPABASE_URL and SUPABASE_ANON_KEY are also
# needed client-side for the browser to talk to Supabase Auth directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_ -- launch:check fails the
# build if a service-role-looking key is ever exposed under that prefix.
SUPABASE_SERVICE_ROLE_KEY=

# VECTOR DATABASE — Pinecone. Pinecone stores the vectors and does the
# embedding on its own side, for both the passages and the question, so no
# embedding model runs anywhere in this system. The index is created
# automatically the first time a document is uploaded.
# Leave the key unset and DearPolicy falls back to keyword search, which still
# answers, just less well. Get a key at app.pinecone.io.
PINECONE_API_KEY=
# PINECONE_INDEX=dearpolicy
# PINECONE_EMBED_MODEL=llama-text-embed-v2
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Local file store. Replace with S3 provider later.
LOCAL_STORAGE_DIR=./data/storage

# DEVELOPMENT-ONLY identity shortcut. Required (must be exactly "true") for
# the shared-household-password gate (lib/auth/gate.ts) and the fixed
# DEV_ACCOUNT_ID below to do anything at all -- both are hard-disabled
# otherwise, and both are ALWAYS disabled in production regardless of this
# flag (a production boot with DEV_AUTH_ENABLED=true refuses to start; see
# lib/launch/guards.ts). This is the "explicit development-only flag" the
# launch-hardening requirements call for: real production auth is Supabase
# Auth (see the PR description for status), not this.
DEV_AUTH_ENABLED=true
SITE_PASSWORD=
DEV_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# Per-document semantic relevance gate (cosine distance, 0 = closest).
# Lexical matches are always retained. Leave this at the tested default unless tuning with labelled examples.
RAG_MAX_COSINE_DISTANCE=0.72

# Passages read per document per question. Scales with document size between
# these bounds; lower the maximum for faster, shallower answers.
RAG_MIN_PASSAGES_PER_DOCUMENT=6
RAG_MAX_PASSAGES_PER_DOCUMENT=16

# Hard ceilings on the reading work one question can buy. Raise these to read
# more of a long booklet; lower them for faster, cheaper answers. The sections
# of a document are read concurrently, so this bounds spend more than it bounds
# wall-clock time.
RAG_MAX_EVIDENCE_WINDOWS=8
RAG_ANALYSIS_BUDGET_MS=150000
# Characters of evidence handed to the model in one section. Bigger sections
# mean fewer calls and whole clauses rather than halves; smaller ones mean a
# long document needs more sections and is likelier to run out of budget.
RAG_EVIDENCE_WINDOW_CHARACTERS=14000

# Output tokens per evidence section. Time per call is almost exactly output
# tokens divided by the model's tokens/sec.
RAG_READING_OUTPUT_TOKENS=900

# ONE KEY, WHOLE SYSTEM. Every model job is hosted; nothing runs on the machine
# serving the app. These two are all DearPolicy needs to read documents, decide
# what applies and word answers.
MODEL_PRESET=gemini
GEMINI_API_KEY=
# Other presets: anthropic (ANTHROPIC_API_KEY), openai (OPENAI_API_KEY).

# Or route each job yourself: "provider:model". Providers: gemini, anthropic,
# openai, groq — each needs its key below. Unset jobs use the preset, and
# failing that, Google.
#   reading    - a document once, at upload (volume; cheap tier)
#   judgement  - interpreting a message, deciding which benefits respond (mid tier)
#   narration  - two sentences around figures code computed (cheapest)
# READING_MODEL=gemini:flash-lite
# JUDGEMENT_MODEL=gemini:flash
# NARRATION_MODEL=gemini:flash-lite
# chat    - the live chat turn's interpretation; falls back to JUDGEMENT_MODEL
# CHAT_MODEL=gemini:flash
# Pages read in parallel per catalogue pass at upload (not secret; default 4).
# READING_CONCURRENCY=4
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Plan allowances shown on the Usage page. The hard stop halts hosted calls
# for the month once a household's model spend passes it.
# PLAN_NAME=Individual
# PLAN_PRICE_USD=4.99
# PLAN_CHAT_TURNS=150
# PLAN_DOCUMENTS=12
# PLAN_HARD_STOP_USD=15

# Security secret. Required in production (see lib/launch/guards.ts's
# checkRequiredProductionSecrets, which refuses to boot without it). Used by
# lib/telemetry/pseudonymize.ts to derive one-way, environment-stable
# pseudonyms for account/member/household ids in telemetry events, so a raw
# id never leaves this process. Any long random string; rotate by changing
# it (existing pseudonyms will no longer match, which is the point when
# rotating after a suspected leak). Falls back to a well-known, clearly
# insecure constant outside production so local development needs no setup.
TELEMETRY_PSEUDONYM_SECRET=

# Optional. Signs the short-lived upload intents that tie the direct-upload
# steps together (app/api/policies/upload/intent-token.ts: start -> part ->
# finalize). Falls back to TELEMETRY_PSEUDONYM_SECRET, then the Supabase
# service-role key, then CRON_SECRET; production refuses to sign an intent
# when none is set. Any long random string, server-side only (never
# NEXT_PUBLIC_); rotating it only invalidates uploads in progress.
# UPLOAD_INTENT_SECRET=

# Set to "true" only once a real TelemetryAdapter (lib/telemetry/adapters.ts)
# is wired in for this environment's actual telemetry destination.
# lib/launch/guards.ts refuses to start production without this, because
# the default NoopTelemetryAdapter accepts every recordEvent() call and
# silently emits nothing -- better a startup crash than silent data loss.
# TELEMETRY_PRODUCTION_ADAPTER_CONFIGURED=true

# Prototype / internal-testing alternative to the flag above. Set to "true"
# to knowingly run production WITHOUT operational telemetry: startup logs a
# prominent warning, events are still redacted but go nowhere, no alert can
# fire, and launch:check reports operational_telemetry as an acknowledged
# limitation (never ready). Exactly one of this and
# TELEMETRY_PRODUCTION_ADAPTER_CONFIGURED must be set, or production refuses
# to start. Never use this for real users.
# TELEMETRY_INTENTIONALLY_DISABLED=true

# Malware scanning for uploaded policy and claim-evidence files
# (lib/scanning/adapter.ts). Unset in production refuses to boot unless
# MALWARE_SCANNING_INTENTIONALLY_DISABLED=true explicitly acknowledges that
# every upload will sit in quarantine forever with no scanner to clear it.
# MALWARE_SCANNER_PROVIDER=virustotal
# MALWARE_SCANNING_INTENTIONALLY_DISABLED=false
# The only real scanner currently registered (lib/scanning/adapters/
# virustotal.ts). Selected via MALWARE_SCANNER_PROVIDER=virustotal.
# VIRUSTOTAL_API_KEY=
# VIRUSTOTAL_API_BASE_URL=https://www.virustotal.com/api/v3
# VIRUSTOTAL_REQUEST_TIMEOUT_MS=15000
# VIRUSTOTAL_POLL_INTERVAL_MS=3000
# VIRUSTOTAL_POLL_BUDGET_MS=60000
# VIRUSTOTAL_MAX_TRANSIENT_RETRIES=2
# VIRUSTOTAL_RETRY_BACKOFF_BASE_MS=500

# Supabase Storage bucket names (lib/storage/supabase.ts), only read when
# STORAGE_DRIVER resolves to "supabase" (production default once SUPABASE_URL
# is set). Sensible defaults below; only set these to use different buckets.
# SUPABASE_STORAGE_BUCKET=policy-files
# SUPABASE_CLAIM_EVIDENCE_BUCKET=claim-evidence-files
# SUPABASE_HOUSEHOLD_EXPORT_BUCKET=household-exports
# Local-disk fallback paths (lib/storage/local.ts), only used when
# STORAGE_DRIVER=local or no Supabase project is configured. Local disk does
# not survive a serverless deployment across requests -- fine for
# development, never for production.
# LOCAL_CLAIM_EVIDENCE_DIR=./data/claim-evidence
# LOCAL_HOUSEHOLD_EXPORT_DIR=./data/household-exports
# STORAGE_DRIVER=local forces local disk; STORAGE_DRIVER=supabase forces
# Supabase Storage. Unset, the choice follows whether SUPABASE_URL is set.
# STORAGE_DRIVER=

# Client-side Supabase credentials for the browser bundle (lib/supabase/
# browser.ts, lib/supabase/env.ts) -- the NEXT_PUBLIC_-prefixed counterparts
# of SUPABASE_URL / SUPABASE_ANON_KEY above, required because only
# NEXT_PUBLIC_* variables are readable client-side under Next.js. Never put
# SUPABASE_SERVICE_ROLE_KEY behind a NEXT_PUBLIC_ name -- launch:check fails
# the build if it detects that.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Per-provider request overrides. Only needed to point at a proxy, a
# self-hosted-compatible endpoint, or a non-default model; every provider
# has a working default without these.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=
# GEMINI_ENDPOINT=vertex enables Vertex AI express mode instead of the
# default AI Studio endpoint; leave unset for AI Studio keys.
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# Legacy per-job routing predating provider:model MODEL overrides above;
# only READING_MODEL_PROVIDER=groq (with GROQ_API_KEY set) currently has any
# effect, for the document-reading job specifically.
# READING_MODEL_PROVIDER=
# Overrides the model used when the judgement job's primary model call
# fails, instead of the automatic same-preset fallback.
# JUDGEMENT_FALLBACK_MODEL=

# Message-intent judgement provider (lib/ai/judge.ts). "rules" uses a fixed
# rule set with no model call; unset/anything else uses the hosted judgement
# model; "typesafe" is reserved for a future local decision model and is not
# wired to a real backend yet -- selecting it without TYPESAFE_API_KEY throws.
# JUDGMENT_PROVIDER=
# TYPESAFE_API_KEY=

# Canary rollout for governed AI operations (lib/ai/rollout.ts). Turns a
# canary model on for one operation via CONFIGURATION alone, rolled out to a
# deterministic percentage of subjects. Pattern (not a literal name --
# <OPERATION> is one of lib/ai/provenance.ts's KNOWN_OPERATIONS, upper-cased:
# POLICY_EXTRACTION, COVERAGE_EXTRACTION, BENEFIT_EXTRACTION,
# CONDITION_CATALOG_EXTRACTION, CLAIM_EVIDENCE_EXTRACTION,
# CLAIM_FACT_FINDING, MEDICAL_EVIDENCE_EXTRACTION, CHAT_REPLY,
# CHAT_FACT_FINDING, RELEVANCE_JUDGING, RAG_ANSWER, CATALOG_BUILDING,
# LEDGER_EXTRACTION, HOSTED_OCR):
#   CANARY_<OPERATION>_MODEL       "provider:model" (e.g. "anthropic:claude-haiku-4-5").
#                                  Absent/empty -- no canary for this operation.
#   CANARY_<OPERATION>_PERCENTAGE  0-100, default "0" (configured but off).
#   CANARY_<OPERATION>_KILL_SWITCH "true" forces this one operation to stable.
# CANARY_KILL_SWITCH_ALL="true" forces EVERY operation to stable at once,
# regardless of per-operation settings -- the incident-response override.
# CANARY_KILL_SWITCH_ALL=

# Connection pool ceiling for the shared Postgres pool (lib/db/client.ts).
# Keeps a burst of short-lived serverless invocations from exhausting
# Postgres's own, much lower, direct-connection limit.
# DATABASE_POOL_MAX=5

# IANA time zone used for claim date calculations (lib/claims/dates.ts) when
# no per-request override is supplied. Falls back to this value, then to
# Asia/Singapore, if unset or invalid.
# CLAIM_TIME_ZONE=Asia/Singapore

# Passages embedded per batch during document indexing (lib/rag/ingest.ts).
# Clamped to 1-12 regardless of what is configured here.
# EMBED_BATCH_SIZE=4

# Set to "0"/"false"/"off" to skip OCR for scanned/image-only PDF pages
# (lib/documents/ocr.ts) even when pages would otherwise need it. Any other
# value (including unset) leaves OCR on.
# OCR_ENABLED=true

# Background worker process (scripts/worker.ts) poll interval in
# milliseconds -- how often an idle worker checks for newly queued jobs.
# DEARPOLICY_WORKER_POLL_INTERVAL_MS=2000

# --- Testing / CI / local-tooling only -- never needed to run the app ---
# scripts/e2e/shared.ts: directory the multi-process browser E2E suite reads
# fixture files (sample PDFs, etc.) from.
# E2E_FIXTURE_DIR=
# scripts/extraction-eval.ts: minimum acceptable recall for the offline
# extraction-quality eval harness; the eval fails below this threshold.
# EXTRACTION_MIN_RECALL=
# lib/auth/session.ts: lets regression suites simulate a stale dev session
# (for requireRecentAuthentication()) without a real Supabase project to
# sign in against. Only read when DEV_AUTH_ENABLED=true. Unset, a dev
# session is always "just signed in."
# DEV_LAST_SIGN_IN_AT=
# lib/ai/deterministic-model.ts: deterministic model stand-in for the
# synthetic browser journey ONLY (value: synthetic-e2e). It also requires
# E2E_RUN_ID, NODE_ENV other than production, and no VERCEL / VERCEL_ENV;
# the value chaos-<seed> (Round 8 chaos model, lib/ai/chaos-model.ts) also
# requires NODE_ENV=test;
# a production or Vercel server refuses to start if this is set at all
# (lib/launch/guards.ts). Never set it anywhere else.
# DEARPOLICY_DETERMINISTIC_MODEL=
# E2E_RUN_ID=
# Set by Vercel itself on its builds and servers (never set by hand); read
# only to keep the deterministic model stand-in off hosted environments.
# VERCEL=
# VERCEL_ENV=

# Background jobs on Vercel. Request handlers only enqueue durable jobs
# (policy and claim-evidence processing, household export, chat analysis,
# model-staleness audits); /api/internal/jobs/run claims and runs one
# bounded batch per call. Callers must send "Authorization: Bearer
# <CRON_SECRET>"; the runner refuses every call when this is unset or shorter
# than 16 characters, and production refuses to START without it
# (lib/launch/guards.ts). Use a long random value, Production scope only,
# type Sensitive. Outside Vercel, `npm run jobs:worker` does the same work as
# a long-running process instead.
#
# vercel.json schedules the runner once a day ("0 3 * * *"), which is all
# Vercel Hobby allows. That is a backstop sweep, NOT a trigger for
# interactive uploads: launch:check stays blocked until a trigger runs at
# least every 5 minutes -- either Vercel Pro with "* * * * *" in vercel.json,
# or an approved external scheduler calling the endpoint, attested with
# JOB_RUNNER_EXTERNAL_SCHEDULER_CONFIRMED=true (see docs/production-job-topology.md).
# CRON_SECRET=
# JOB_RUNNER_EXTERNAL_SCHEDULER_CONFIRMED=
#
# Request-driven drain (lib/jobs/request-drain.ts): after an authenticated
# household request to an enqueueing or status-polling route has been
# answered, run one small bounded batch (at most 2 jobs, 20 s claim window,
# one in flight and one start per 5 s per instance) with the same runner the
# cron endpoint uses. This is what makes uploads and scan retries progress
# promptly on Vercel Hobby while the app is in use; the daily Cron is the
# idle-time backstop. On by default; set to false where a standalone
# `npm run jobs:worker` or a frequent Cron is the trigger instead.
# JOB_DRAIN_ON_REQUEST=
#
# CI-only: the production-topology proof (.github/workflows/production-topology.yml,
# scripts/topology/*). Never set these in a deployed environment.
# TOPOLOGY_RUN_ID=
# TOPOLOGY_BASE_URL=
# TOPOLOGY_FAKE_URL=

# OS-provided process basics, read only by scripts/test-adapter-production-
# refusal-regressions.ts to build a minimal child-process environment for
# its startup-refusal probes. Never set these in Vercel or any DearPolicy
# configuration; the operating system provides them. Not secret.
# PATH=
# HOME=

# --- V1 core-loop verification (local synthetic stack only; not secrets) ---
# Synthetic dev-identity user ids for households A and B (see e2e/README.md).
# E2E_USER_A=
# E2E_USER_B=
# Set by scripts/v1-db-verification.ts itself to force read-only sessions.
# PGOPTIONS=
# The verifier refuses a non-localhost DATABASE_URL unless this is "yes".
# V1_VERIFY_ALLOW_REMOTE=

# --- V1.1 ---
# Longest time (ms) one model call may spend retrying transient provider
# errors before failing cleanly (quota/billing errors are never retried).
# MODEL_RETRY_WINDOW_MS=20000
# The owner's monthly spend cap on the model provider account, in USD. Shown
# on the operator page for comparison with recorded usage. DearPolicy does NOT
# enforce it -- the provider does. (PLAN_HARD_STOP_USD is the per-household
# stop DearPolicy itself enforces.) Not secret.
# OWNER_PROVIDER_BUDGET_USD=5
# Local synthetic test harness only (never production; not secrets):
# E2E_AUTH_BASE_URL=        # fake-auth base URL for the V1.1 login browser test
# E2E_CHROMIUM_PATH=        # Chromium executable for local Playwright runs
# V11_EVAL_COMMIT=          # commit id recorded in V1.1 evaluation reports
# V11_EVAL_KEEP=            # "1" keeps the evaluation's synthetic data for inspection
# V11_UX_SYNTHETIC_PASSWORD= # random per run if unset; synthetic fake-auth account only
# R6_DUMP=                  # Round 6 chat-quality suite: write every judged turn as JSON lines to this file
# R6_ONLY=                  # Round 6 chat-quality suite: run only conversations whose name contains this text
# R6_SHOW=                  # Round 6 chat-quality suite: how many failing turns to print (default 40)
# R7_DUMP=                  # Round 7 suites (answers and claim conversations): write every judged turn as JSON lines to this file
# R7_ONLY=                  # Round 7 suites (answers and claim conversations): run only conversations whose name contains this text
# E2E_R8_BASE_URL=          # Round 8 chat-display browser spec and scripts/r8/live-render.ts: the app to drive (default http://localhost:3200)
# R8_RENDER_FULL=           # Round 8 chat-display spec: 1 = every recorded answer (default: the fixed set)
# R8_RENDER_SHOTS=          # Round 8 chat-display spec: keep a screenshot of every answer in this directory
# R8_RENDER_REPORT=         # Round 8 chat-display spec: write every answer's display findings as JSON lines to this file
# R7_SHOW=                  # Round 7 suites: how many failing turns to print (default 40 answers, 60 claim conversations)
# R8_SEEDS=                 # Round 8 chaos suite: comma-separated chaos-model seeds to run (default 1,2); test-only, not secret
# R8_REPEAT=                # Round 12: run every chaos seed this many times and fail if any repeat differs (default 1); test-only, not secret
# R8_CHAOS_SEED=            # Round 8: set by the chaos suite for one Round 6/7 battery run (DEARPOLICY_DETERMINISTIC_MODEL=chaos-<seed>); test-only
# R8_SUMMARY=               # Round 8: file the Round 6/7 runners append one JSON summary line to under the chaos suite; test-only
# R9_DUMP=                  # Round 9 red-team suite: write every judged turn as JSON lines to this file (chaos runs add -chaos<seed>); test-only
# R9_ONLY=                  # Round 9 red-team suite: run only conversations whose name contains this text; test-only
# RAG2_ADV_ONLY=            # rag2 adversarial suite (npm run rag2:adversarial-test): run only checks whose name matches this regex; test-only, not secret
# R9_SHOW=                  # Round 9: how many failing turns the red-team suite prints (default 40), or audit violations scripts/r9/ingest-run.ts prints (default 30); test-only
# R9_HOUSEHOLD=             # Round 9 red-team suite: set by the suite for each child run (r6 or r7 fixture household); test-only
# R9_CHAOS_SEEDS=           # Round 9 red-team suite: comma-separated chaos-model seeds to run after the stand-in (default 3); test-only
# R9_NO_CHAOS=              # Round 9 red-team suite: 1 = stand-in only, no chaos-model runs; test-only
# R9_SEEDS=                 # Round 9 ingestion chaos suite: seeds whose document reads are audited (default 1,2,3,4,5,6); test-only, not secret
# CHAT_TURN_MODEL_BUDGET_MS=150000  # Round 10: one chat turn's total model time (ms, 5000-270000); each model call gets at most what is left, so a slow or hanging provider ends the turn with an answer inside the chat function's limit; not secret
# R10_METER=                # Round 10: the r6/r7/r9 batteries write per-turn cost (queries, model calls, tokens, prompt size) as JSON lines to this file; test-only
# R10_METER_KINDS=          # Round 10: 1 = the meter also lists each turn's queries by kind; test-only
# R10_SUITE=                # Round 10: label written on each metered line; test-only
# R10_REPORT=               # Round 10 perf suite: write every metered turn as JSON lines to this file; test-only
# R10_SCALE=                # Round 10: 1 = the Round 6 battery first grows its household to 10 people and 40 documents (scripts/r10/scale.ts); test-only
# R9_CHAT_SEEDS=            # Round 9 ingestion chaos suite: seeds whose households are run through the Round 6/7 batteries (default 1,2); test-only
# R9_MAX_DEGRADED=          # Round 9 ingestion chaos suite: largest share of turns allowed to fall back to an honest "not found" (default 0.15); test-only
# R9_REPEAT=                # Round 13 ingestion chaos suite: read every household and run every battery this many times per seed and fail if any repeat differs (default 1); test-only, not secret
# R9_SNAPSHOT_OUT=          # Round 13: scripts/r9/ingest-run.ts also writes the stored-fact snapshot of a chaos read to this file (debugging); test-only, not secret
# R9_INGEST_SEED=           # Round 9: read every Round 6/7 fixture document under DEARPOLICY_DETERMINISTIC_MODEL=ingest-chaos-<seed>; test-only
# R9_PRISTINE=              # Round 9: snapshot of the same household read by the well-behaved stand-in (who holds what, for the detectors); test-only
# R9_SUITE=                 # Round 9: which fixture household scripts/r9/ingest-run.ts builds (r6 or r7); test-only
# R9_OUT=                   # Round 9: where scripts/r9/ingest-run.ts writes its snapshot or audit; test-only
# R10_DUMP=                 # Round 10 messy-uploads suite: write every judged turn as JSON lines to this file; test-only
# R10_ONLY=                 # Round 10 messy-uploads suite: run only battery groups or conversations whose name contains this text; test-only
# R11_DUMP=                 # Round 11 blind evaluation: write every judged turn as JSON lines to this file; test-only
# R11_ONLY=                 # Round 11 blind evaluation: run only conversations whose id contains this text (e.g. tl-, rh-15); test-only
# R7R_PHASES=               # Round 7 chat-robustness suite: comma-separated phases to run (default battery,traps,group,chaos,long); test-only
# R7R_HOUSEHOLDS=           # Round 7 chat-robustness suite: comma-separated households to load (default H1-tan,H2-aisyah,H3-ong); test-only
# R7R_ONLY=                 # Round 7 chat-robustness suite: run only battery items whose id matches this regular expression; test-only
# R7R_REPORT=               # Round 7 chat-robustness suite: 1 = print every failing item and do not fail the run; test-only
# R7R_SEEDS=                # Round 7 chat-robustness suite: comma-separated chaos-model seeds (default 1..6); test-only, not secret
# R7R_SKIP_CHAT_CHAOS=      # Round 7 chat-robustness suite: 1 = skip the chat chaos phase; test-only
# R7R_DUMP=                 # Round 7 chat-robustness suite: write every judged battery turn as JSON lines to this file; test-only
# R7R_DISPUTES=             # Round 7 chat-robustness suite: JSON-lines file of disputed battery items (id, turn); the report adds a score excluding them; test-only
# R7R_DUMP_LONG=            # Round 7 chat-robustness suite: write every long-chat turn as JSON lines to this file; test-only
# R7R_DUMP_CHAOS=           # Round 7 chat-robustness suite: write what the upload chaos reader stored as JSON lines to this file; test-only
# R7R_DUMP_R6=              # Round 7 chat-robustness suite: write every long Round 6 chat turn as JSON lines to this file; test-only
# R7R_VERBOSE=              # Round 7 chat-robustness suite: 1 = print each document as it is read; test-only
# R10_SHOW=                 # Round 10 messy-uploads suite: how many failing turns to print (default 40); test-only
# R10_SUMMARY=              # Round 10 messy-uploads suite: write the defect counts by category as JSON to this file; test-only
# R10_OUT=                  # Round 10: where scripts/r10/read-report.ts writes how each upload was read (JSON); test-only
# R9_REREAD=                # Round 9: re-read every document with a failing reader (1 = cached readings dropped, cached = kept); test-only
# R9_DEBUG=                 # Round 9: print why a fixture document failed to read under the ingestion chaos stand-in; test-only
# DP_GATE_DEBUG=            # Gate R17: 1 = the save-time answer gate (lib/chat/answer-verification.ts) writes every figure it removes, with the binding it tried, to stderr; diagnostics only, default off, not secret
# DEARPOLICY_RAG_TOOLS=     # Conversational RAG (lib/rag2): 1 = the common retrieval tools (search, read page, people, policies, table values, calculations) may run; default off -- with it off the existing chat path is unchanged; not secret
# DEARPOLICY_RAG_TOOLS_ALLOW_PRODUCTION=  # Conversational RAG: a production build (NODE_ENV=production or any Vercel deployment) refuses DEARPOLICY_RAG_TOOLS unless this is also 1; not secret
# DEARPOLICY_RAG_LOOP=      # Conversational RAG (lib/rag2/loop): 1 = chat turns go through the model-driven conversation loop (CHAT_MODEL with tool calling; implies the lib/rag2 tools for the loop's own calls); default off -- with it off the existing chat path is unchanged; not secret
# DEARPOLICY_RAG_LOOP_ALLOW_PRODUCTION=  # Conversational RAG loop: a production build (NODE_ENV=production or any Vercel deployment) refuses DEARPOLICY_RAG_LOOP unless this is also 1; not secret
# DEARPOLICY_RAG_LOOP_MAX_STEPS=   # Conversational RAG loop: model calls per chat turn, failed attempts and retries included (default 12, max 40); not secret
# DEARPOLICY_RAG_LOOP_MAX_TOKENS=  # Conversational RAG loop: input+output tokens per chat turn across its model calls, checked before each call (default 80000, max 200000); not secret
# DEARPOLICY_RAG_LOOP_MAX_OUTPUT_TOKENS=  # Conversational RAG loop: output tokens per model call (default 2000); not secret
# DEARPOLICY_RAG_LOOP_MAX_TURN_USD=  # Conversational RAG loop: priced model cost per chat turn, US$ (default 0.05); clamped to 80% of OWNER_PROVIDER_BUDGET_USD (US$5 -> 4); not secret
# DEARPOLICY_RAG_LOOP_HOUSEHOLD_MONTHLY_USD=  # Conversational RAG loop: loop model spend per household per month, US$ (default 1; unpriced models budgeted at a high fallback price); clamped like the above; not secret
# DEARPOLICY_RAG_LOOP_RUN_MAX_CALLS=  # Conversational RAG loop: model calls per process (an evaluation run / one Preview instance; default 150); not secret
# DEARPOLICY_RAG_LOOP_RUN_MAX_USD=  # Conversational RAG loop: model spend per process, US$ (default 0.50); clamped like the above; not secret
# DEARPOLICY_RAG_LOOP_RETRIES=  # Conversational RAG loop: retries of a failed (retryable) model call, each counted and recorded (default 1, max 2); not secret
# DEARPOLICY_RAG_LOOP_CALL_TIMEOUT_MS=  # Conversational RAG loop: one model call's timeout; the request is aborted (default 45000); not secret
# DEARPOLICY_RAG_LOOP_TURN_TIMEOUT_MS=  # Conversational RAG loop: all model calls of one chat turn (default 120000; the chat's own model budget also applies); not secret
# None of these is a spend cap on the provider API key: they are DearPolicy's own limits, kept beneath the owner's budget.
# DEARPOLICY_RAG_LOOP_REQUIRE_PRICE=  # Conversational RAG loop: 1 = refuse any model call with no price on file (fail closed; set for live / real-model runs); default unset (an unpriced model is counted at a fallback price); not secret
# RAG2_PRES_ONLY=            # npm run rag2:presentation-test: run only the checks whose name matches this regex; test-only, not secret
# REPRO=                    # npm run rag2:conv2-test: 1 = also print the visible text of the replayed L3 / L4 / L3b conversations; test-only, not secret
# DEBUG_CONV2=               # npm run rag2:conv2-test: 1 = print the L4 replay's dropped sentences, gate results and tool calls; test-only, not secret
# CONV5_TOKEN_LIMIT=         # npm run rag2:conv5-test: the loop's per-turn token limit for the budget replay (default 80000); test-only, not secret
# RAG2_LIVE_PREFLIGHT=       # rag2 live smoke (scripts/rag2-live/run.ts, e2e/support/rag2-live-guard.ts): 1 = refuse the first model call without reserving budget (plumbing check, no model call); set by run.ts --preflight; test-only, not secret
# RAG2_LIVE_KEY_PRESENT=     # rag2 live smoke: "false" when the workflow had no OPENAI_TEST_API_KEY (the report says so); set by .github/workflows/rag2-live-smoke.yml; not secret
# GITHUB_OUTPUT=             # GitHub Actions: path of the step-output file; scripts/rag2-live/ledger.ts `plan` appends run_id / scenarios / cap / remaining / preflight to it when set (set by the runner, never configured by hand); not secret
# INGEST_LIVE_EXPECTED=      # live ingestion test (scripts/ingest-live/run.ts): path of the sealed EXPECTED.json, copied into the run folder only after the conversations (same as --expected); test-only, not secret
# INGEST_LIVE_READY_TIMEOUT_MS= # live ingestion test: how long the browser waits for each upload to finish processing (default 900000; preflight 150000); test-only, not secret
# INGEST_LIVE_THINK_MS=      # live ingestion test: how long the browser waits for one chat reply (default 240000); test-only, not secret
# INGEST_LIVE_TEST_TIMEOUT_MS= # live ingestion test: the whole browser journey's time limit (default 4500000); test-only, not secret
# CI=                       # set by CI runners (GitHub Actions: true); scripts/ingest-live/run.ts passes it through to the browser journey; e2e/support/rag2-live-guard.ts requires it for direct mode; never configured by hand; not secret
# PLAYWRIGHT_BROWSERS_PATH=  # Playwright: where its browsers are installed; scripts/ingest-live/run.ts passes it through to the browser journey when set (normally unset); not secret
# RUNNER_TEMP=               # GitHub Actions: the runner's temporary directory (set by the runner, never configured by hand); scripts/ingest-live/run.ts keeps the run's local upload storage there (falls back to /tmp); not secret
