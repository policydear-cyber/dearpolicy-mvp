# Local PostgreSQL + pgvector
DATABASE_URL=postgresql://dearpolicy:dearpolicy@127.0.0.1:5432/dearpolicy

# Local Ollama/Qwen model.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=local
LLM_MODEL=qwen3.5:9b

# Ollama native embeddings endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
EMBED_DIMENSIONS=1024

# Local file store. Replace with S3 provider later.
LOCAL_STORAGE_DIR=./data/storage

# Development account; public auth is intentionally not part of local MVP.
DEV_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# Local GPU stability defaults (8 GB friendly)
LLM_CONTEXT_SIZE=4096
LLM_NUM_BATCH=256
EMBED_BATCH_SIZE=4

# Per-document semantic relevance gate (cosine distance, 0 = closest).
# Lexical matches are always retained. Leave this at the tested default unless tuning with labelled examples.
RAG_MAX_COSINE_DISTANCE=0.72

# Optional local PaddleOCR. Run INSTALL-OCR.cmd once. DearPolicy then detects
# the private installation automatically and uses it only for scanned pages.
OCR_ENABLED=true
OCR_PIPELINE_VERSION=v1.6
OCR_DEVICE=auto
OCR_RENDER_DPI=200
OCR_TIMEOUT_MS=1800000

# Passages read per document per question. Scales with document size between
# these bounds; lower the maximum if analysis is too slow on your GPU.
RAG_MIN_PASSAGES_PER_DOCUMENT=6
RAG_MAX_PASSAGES_PER_DOCUMENT=16

# Hard ceilings on local-model reading work for a single question. Raise these
# to read more of a long booklet; lower them for faster answers.
RAG_MAX_EVIDENCE_WINDOWS=8
RAG_ANALYSIS_BUDGET_MS=300000
# Output tokens per evidence section. This is the main speed control: time per
# call is almost exactly output tokens divided by the model's tokens/sec.
RAG_READING_OUTPUT_TOKENS=900
# How long the chat model stays loaded within one analysis phase.
LLM_KEEP_ALIVE=5m

# Reading model — reads each document once at upload. Leave unset to read with
# the local model. Groq's free tier works and its terms forbid training on your
# data; get a key at console.groq.com.
# READING_MODEL_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ONE KEY, WHOLE SYSTEM. Set these two and nothing local is needed (no Ollama,
# no BGE-M3): Claude reads documents, decides what applies and words answers.
# MODEL_PRESET=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Other presets: gemini (GEMINI_API_KEY), openai (OPENAI_API_KEY).

# Or route each job yourself: "provider:model". Providers: ollama, groq, anthropic,
# openai, gemini (each hosted one needs its key below). Unset = local model.
#   reading    - a document once, at upload (volume; cheap tier)
#   judgement  - interpreting a message, deciding which benefits respond (mid tier)
#   narration  - two sentences around figures code computed (cheapest)
# READING_MODEL=gemini:gemini-2.5-flash-lite
# JUDGEMENT_MODEL=anthropic:claude-haiku-4-5
# NARRATION_MODEL=anthropic:claude-haiku-4-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Plan allowances shown on the Usage page. The hard stop halts hosted calls
# for the month once a household's model spend passes it.
# PLAN_NAME=Individual
# PLAN_PRICE_USD=4.99
# PLAN_CHAT_TURNS=150
# PLAN_DOCUMENTS=12
# PLAN_HARD_STOP_USD=15
